# Banco de dados (Postgres com a extensão pgvector; em produção, Neon).
#
# São duas URLs porque são dois papéis diferentes, de propósito:
#
# - DATABASE_URL usa o endpoint COM pooler e o papel da APLICAÇÃO, que só faz
#   leitura e escrita de linha. Função serverless abre e fecha conexão o tempo
#   todo, e sem o pooler o Postgres esgota o limite em minutos.
# - DIRECT_URL usa o endpoint SEM pooler e o papel DONO do banco, o único que
#   pode criar e alterar tabela. É o que o Prisma exige para aplicar esquema, e
#   pelo pooler falharia com um erro sobre transação preparada que não ajuda
#   ninguém a achar a causa.
#
# No Neon o endereço do pooler é o mesmo do direto com "-pooler" antes da região.
DATABASE_URL="postgresql://APP:SENHA@ep-SEU-ENDPOINT-pooler.sa-east-1.aws.neon.tech/permaneia?sslmode=require"
DIRECT_URL="postgresql://DONO:SENHA@ep-SEU-ENDPOINT.sa-east-1.aws.neon.tech/permaneia?sslmode=require"

# Segredo de assinatura das sessões (mínimo 32 caracteres).
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Google Gemini API, tier gratuito do Google AI Studio (https://aistudio.google.com/apikey).
# Sem chave, o sistema cai automaticamente no provedor local determinístico e
# continua respondendo, de forma extrativa, apenas com os trechos recuperados.
GEMINI_API_KEY=""
# Os aliases "-latest" sao propositais: o Google aposenta versoes nomeadas com
# frequencia, e uma versao fixa pararia de responder sem aviso no meio do
# semestre. Ver o comentario em lib/ia/gemini.ts.
GEMINI_MODELO_TEXTO="gemini-flash-lite-latest"
GEMINI_MODELO_EMBEDDING="gemini-embedding-001"

# "off" força o provedor local mesmo com a chave configurada (útil em demonstração
# offline e nos testes de integração).
IA_EXTERNA="on"

# Modo demonstração: libera o acesso de vitrine sem cadastro prévio.
DEMO_MODE="off"

# "false" ignora x-forwarded-for no rate limit, para ambientes sem proxy confiável.
RATE_LIMIT_CONFIA_PROXY="true"

# Tentativas de login permitidas por minuto e por endereço. O padrão de 5 protege
# contra adivinhação de senha, mas derruba uma turma inteira entrando ao mesmo
# tempo de um laboratório atrás de NAT. Aumente conforme a topologia da rede.
RATE_LIMIT_LOGIN="5"

# Dias de retenção do log de auditoria e do histórico de consultas (LGPD.md).
RETENCAO_AUDITORIA_DIAS="365"

# Onde fica o arquivo ORIGINAL de cada documento indexado (ADR 012).
#
# Com S3_BUCKET preenchido, vai para armazenamento de objetos; sem ele, vai para
# o disco, em data/documentos. Na Vercel sem S3_BUCKET a ingestão falha de
# propósito: o disco da função é só de leitura, e /tmp some entre invocações,
# então gravar lá perderia o arquivo depois sem erro nenhum.
#
# Credencial NÃO se configura aqui. Rodando na AWS, o papel da instância ou da
# tarefa é o caminho certo, e o SDK o encontra sozinho. Chave em variável de
# ambiente (AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY) é para quem não tem
# papel, como o LocalStack do docker-compose.
S3_BUCKET=""
AWS_REGION="sa-east-1"

# Endereço alternativo, só para LocalStack ou serviço compatível com S3.
# Com o perfil aws do docker-compose: http://localhost:4566
S3_ENDERECO=""

# Raiz do armazenamento em disco, quando não há bucket.
DOCUMENTOS_RAIZ=""
